<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="flt_module_privilege" model="res.groups.privilege">
            <field name="name">Flight &amp; Visa Management</field>
            <field name="category_id" ref="base.module_category_customizations"/>
        </record>

        <record id="group_flt_user" model="res.groups">
            <field name="name">FLT User</field>
            <field name="privilege_id" ref="flt_module_privilege"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Can manage flights, visas, passports and documents for customers.</field>
        </record>

        <record id="group_flt_manager" model="res.groups">
            <field name="name">FLT Manager</field>
            <field name="privilege_id" ref="flt_module_privilege"/>
            <field name="implied_ids" eval="[(4, ref('group_flt_user'))]"/>
            <field name="comment">Can manage all FLT records, approve cancellation requests, configure policies.</field>
        </record>

        <record id="group_flt_administrator" model="res.groups">
            <field name="name">FLT Administrator</field>
            <field name="privilege_id" ref="flt_module_privilege"/>
            <field name="implied_ids" eval="[(4, ref('group_flt_manager'))]"/>
            <field name="comment">Full module configuration access.</field>
        </record>

        <!-- ==================== Portal record rules ==================== -->
        <!-- Own-records-only access, enforced server-side (never trust the
             portal UI alone). Internal (FLT User+) users are covered by a
             separate "see everything" rule below. -->

        <record id="rule_flt_passport_portal_own" model="ir.rule">
            <field name="name">FLT Passport: portal user sees only own</field>
            <field name="model_id" ref="model_flt_passport"/>
            <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <record id="rule_flt_visa_portal_own" model="ir.rule">
            <field name="name">FLT Visa: portal user sees only own</field>
            <field name="model_id" ref="model_flt_visa"/>
            <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <record id="rule_flt_booking_portal_own" model="ir.rule">
            <field name="name">FLT Flight Booking: portal user sees only own</field>
            <field name="model_id" ref="model_flt_flight_booking"/>
            <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <record id="rule_flt_segment_portal_own" model="ir.rule">
            <field name="name">FLT Flight Segment: portal user sees only own booking's segments</field>
            <field name="model_id" ref="model_flt_flight_segment"/>
            <field name="domain_force">[('booking_id.partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <record id="rule_flt_cancellation_request_portal_own" model="ir.rule">
            <field name="name">FLT Cancellation Request: portal user sees only own</field>
            <field name="model_id" ref="model_flt_cancellation_request"/>
            <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <record id="rule_flt_document_portal_own" model="ir.rule">
            <field name="name">FLT Document: portal user sees only own</field>
            <field name="model_id" ref="model_flt_document"/>
            <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <record id="rule_flt_notification_portal_own" model="ir.rule">
            <field name="name">FLT Notification: portal user sees only own</field>
            <field name="model_id" ref="model_flt_notification"/>
            <field name="domain_force">[('partner_id', '=', user.partner_id.id), ('staff_only', '=', False)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <!-- Internal FLT users: unrestricted multi-company-aware access to
             all FLT business records. -->
        <record id="rule_flt_passport_internal_all" model="ir.rule">
            <field name="name">FLT Passport: internal users see all</field>
            <field name="model_id" ref="model_flt_passport"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_flt_user'))]"/>
        </record>

        <record id="rule_flt_visa_internal_all" model="ir.rule">
            <field name="name">FLT Visa: internal users see all</field>
            <field name="model_id" ref="model_flt_visa"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_flt_user'))]"/>
        </record>

        <record id="rule_flt_booking_internal_all" model="ir.rule">
            <field name="name">FLT Flight Booking: internal users see all</field>
            <field name="model_id" ref="model_flt_flight_booking"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_flt_user'))]"/>
        </record>

        <record id="rule_flt_cancellation_request_internal_all" model="ir.rule">
            <field name="name">FLT Cancellation Request: internal users see all</field>
            <field name="model_id" ref="model_flt_cancellation_request"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_flt_user'))]"/>
        </record>

    </data>
</odoo>
