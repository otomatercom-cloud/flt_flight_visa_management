<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_flt_document_list" model="ir.ui.view">
        <field name="name">flt.document.list</field>
        <field name="model">flt.document</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="document_type"/>
                <field name="upload_date"/>
                <field name="expiry_date"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'verified'"
                       decoration-danger="status in ('rejected','expired')"
                       decoration-info="status == 'pending'"/>
            </list>
        </field>
    </record>

    <record id="view_flt_document_form" model="ir.ui.view">
        <field name="name">flt.document.form</field>
        <field name="model">flt.document</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_verify" type="object" string="Verify" invisible="status == 'verified'" class="oe_highlight"/>
                    <button name="action_reject" type="object" string="Reject" invisible="status == 'rejected'"/>
                    <field name="status" widget="statusbar" statusbar_visible="pending,verified"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="partner_id"/>
                            <field name="document_type"/>
                            <field name="attachment_id"/>
                        </group>
                        <group>
                            <field name="related_model"/>
                            <field name="related_res_id"/>
                            <field name="upload_date"/>
                            <field name="expiry_date"/>
                        </group>
                    </group>
                    <field name="notes"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_flt_document" model="ir.actions.act_window">
        <field name="name">Documents</field>
        <field name="res_model">flt.document</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_flt_document_pending" model="ir.actions.act_window">
        <field name="name">Pending Documents</field>
        <field name="res_model">flt.document</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('status','=','pending')]</field>
    </record>

</odoo>
