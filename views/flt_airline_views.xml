<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_flt_airline_list" model="ir.ui.view">
        <field name="name">flt.airline.list</field>
        <field name="model">flt.airline</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_flt_airline_form" model="ir.ui.view">
        <field name="name">flt.airline.form</field>
        <field name="model">flt.airline</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_flt_airline" model="ir.actions.act_window">
        <field name="name">Airlines</field>
        <field name="res_model">flt.airline</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
