<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_flt_flight_segment_list" model="ir.ui.view">
        <field name="name">flt.flight.segment.list</field>
        <field name="model">flt.flight.segment</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="airline_id"/>
                <field name="flight_number"/>
                <field name="departure_airport_id"/>
                <field name="departure_datetime"/>
                <field name="departure_terminal"/>
                <field name="arrival_airport_id"/>
                <field name="arrival_datetime"/>
                <field name="arrival_terminal"/>
                <field name="seat_number"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="action_flt_flight_segment" model="ir.actions.act_window">
        <field name="name">Segments</field>
        <field name="res_model">flt.flight.segment</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
