<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_flt_passport_list" model="ir.ui.view">
        <field name="name">flt.passport.list</field>
        <field name="model">flt.passport</field>
        <field name="arch" type="xml">
            <list decoration-danger="status == 'expired'" decoration-warning="status == 'expiring_soon'">
                <field name="passport_number"/>
                <field name="partner_id"/>
                <field name="full_name"/>
                <field name="nationality_id"/>
                <field name="issue_date"/>
                <field name="expiry_date"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'valid'"
                       decoration-warning="status == 'expiring_soon'"
                       decoration-danger="status == 'expired'"
                       decoration-info="status == 'draft'"/>
            </list>
        </field>
    </record>

    <record id="view_flt_passport_form" model="ir.ui.view">
        <field name="name">flt.passport.form</field>
        <field name="model">flt.passport</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_validate" type="object" string="Validate"
                            invisible="status != 'draft'" class="oe_highlight"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,valid,expiring_soon,expired"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="passport_number"/>
                            <field name="full_name"/>
                            <field name="date_of_birth"/>
                            <field name="nationality_id"/>
                        </group>
                        <group>
                            <field name="issue_date"/>
                            <field name="expiry_date"/>
                            <field name="place_of_issue"/>
                        </group>
                    </group>
                    <group string="Documents">
                        <field name="attachment_ids" widget="many2many_binary"/>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_flt_passport_search" model="ir.ui.view">
        <field name="name">flt.passport.search</field>
        <field name="model">flt.passport</field>
        <field name="arch" type="xml">
            <search>
                <field name="passport_number"/>
                <field name="partner_id"/>
                <filter name="expiring_soon" string="Expiring Soon" domain="[('status','=','expiring_soon')]"/>
                <filter name="expired" string="Expired" domain="[('status','=','expired')]"/>
                <separator/>
                <group>
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_flt_passport" model="ir.actions.act_window">
        <field name="name">Passports</field>
        <field name="res_model">flt.passport</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
