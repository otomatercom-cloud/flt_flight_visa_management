<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_flt_cancellation_request_list" model="ir.ui.view">
        <field name="name">flt.cancellation.request.list</field>
        <field name="model">flt.cancellation.request</field>
        <field name="arch" type="xml">
            <list decoration-danger="status == 'rejected'" decoration-success="status == 'processed'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="booking_id"/>
                <field name="request_date"/>
                <field name="refund_amount"/>
                <field name="status" widget="badge"
                       decoration-success="status in ('approved','processed')"
                       decoration-danger="status in ('rejected','cancelled')"
                       decoration-info="status in ('draft','submitted','under_review')"/>
                <field name="refund_status"/>
            </list>
        </field>
    </record>

    <record id="view_flt_cancellation_request_form" model="ir.ui.view">
        <field name="name">flt.cancellation.request.form</field>
        <field name="model">flt.cancellation.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start_review" type="object" string="Start Review"
                            invisible="status != 'submitted'"/>
                    <button name="action_approve" type="object" string="Approve"
                            invisible="status not in ('submitted','under_review')" class="oe_highlight"
                            groups="flt_flight_visa_management.group_flt_manager"/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="status not in ('submitted','under_review')"
                            groups="flt_flight_visa_management.group_flt_manager"/>
                    <button name="action_mark_processed" type="object" string="Mark Refund Processed"
                            invisible="status != 'approved'" class="oe_highlight"/>
                    <field name="status" widget="statusbar"
                           statusbar_visible="draft,submitted,under_review,approved,processed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="booking_id"/>
                            <field name="request_date"/>
                            <field name="policy_id"/>
                            <field name="customer_confirmed"/>
                        </group>
                        <group>
                            <field name="original_amount"/>
                            <field name="cancellation_charge"/>
                            <field name="additional_charges"/>
                            <field name="refund_amount"/>
                            <field name="final_refund_amount"/>
                            <field name="refund_status"/>
                        </group>
                    </group>
                    <group>
                        <field name="reason"/>
                        <field name="remarks"/>
                    </group>
                    <group string="Approval" groups="flt_flight_visa_management.group_flt_manager">
                        <field name="approved_by_id" readonly="1"/>
                        <field name="approval_date" readonly="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_flt_cancellation_request_search" model="ir.ui.view">
        <field name="name">flt.cancellation.request.search</field>
        <field name="model">flt.cancellation.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="booking_id"/>
                <filter name="pending" string="Pending Review" domain="[('status','in',('submitted','under_review'))]"/>
                <filter name="pending_refund" string="Pending Refund" domain="[('refund_status','in',('pending','approved','processing'))]"/>
                <separator/>
                <group>
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_flt_cancellation_request" model="ir.actions.act_window">
        <field name="name">Cancellation Requests</field>
        <field name="res_model">flt.cancellation.request</field>
        <field name="view_mode">list,form,pivot,graph</field>
    </record>

    <record id="action_flt_cancellation_request_pending" model="ir.actions.act_window">
        <field name="name">Pending Cancellation Requests</field>
        <field name="res_model">flt.cancellation.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('status','in',('submitted','under_review'))]</field>
    </record>

    <record id="action_flt_refunds" model="ir.actions.act_window">
        <field name="name">Refunds</field>
        <field name="res_model">flt.cancellation.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('refund_status','!=','not_applicable')]</field>
    </record>

</odoo>
